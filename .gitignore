# ========================================
# OPERATIVSYSTEM: Windows
# ========================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.cab
*.lnk
Desktop.ini
$RECYCLE.BIN/

# ========================================
# UTVIKLINGSMILJØ: VS Code
# ========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ========================================
# BACKEND: Python
# ========================================
# Byte-compiled / optimalisert / DLL filer
__pycache__/
*.py[cod]
*$py.class

# Virtuelle miljøer
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Hemmeligheter og konfigurasjon (Viktig!)
.env
.env.local
.env.*.local

# Pytest og testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Byggefiler og distribusjon
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ========================================
# DATABASE: SQL / SQLite
# ========================================
# Ignorer lokale databasefiler slik at ikke data/brukere havner i Git
*.db-shm
*.db-wal
*.mdf
*.ldf
*.ndf
# Eventuelle database-dumper
*.sql.gz

# ========================================
# FRONTEND: HTML / CSS / JS
# ========================================
# Hvis du etter hvert bruker Node.js for frontend-pakker
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache

# Cacher fra CSS-prosessorer (Sass/Less)
.sass-cache/
*.css.map